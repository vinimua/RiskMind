# 仅供本地开发。复制为 .env 后修改；不要提交真实密码或密钥。
POSTGRES_USER=risk_dev
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=risk_platform
MINIO_ROOT_USER=local_admin
MINIO_ROOT_PASSWORD=change_me_local_only
RISK_REDIS_URL=redis://localhost:6379/0

# DeepSeek 官方 OpenAI-compatible API（应用只读取进程环境，不自动加载 .env）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 硅基流动 OpenAI-compatible Embeddings（BAAI/bge-m3 标准版）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
MILVUS_URI=http://localhost:19530

# 后续接入时配置：
RISK_DATABASE_URL=postgresql+psycopg://risk_dev:<password>@localhost:5432/risk_platform
# RISK_LIGHTRAG_URL=http://localhost:9621
# RISK_LIGHTRAG_API_KEY=
# RISK_MLFLOW_TRACKING_URI=http://localhost:5000
# RISK_S3_ENDPOINT_URL=http://localhost:9000


# 可选 Langfuse：仅结构化观测，默认关闭；环境变量须由部署加载。
RISK_LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=


# 显式单用户本地 API 组合入口；不用于生产身份认证。
RISK_LOCAL_MODE=1
RISK_LOCAL_ACTOR_ID=local-reviewer
# 自行生成至少 32 字符的独立随机令牌；不是 DeepSeek API Key。
RISK_LOCAL_API_TOKEN=
# 这里是业务模型标识，不是大模型供应商模型名。
RISK_ALLOWED_MODEL_IDS=["credit-v3"]
RISK_KNOWLEDGE_PROFILE=parent-child-v1
